{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipager.local/schemas/aipager-1.0/test-plan.schema.json",
  "title": "AIPager test plan (single source for the design document's test plan and roadmap)",
  "type": "object",
  "required": ["version", "phases", "automated", "manual"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]$" },
          "name": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "automated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "command", "platforms", "covers", "last_result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "platforms": { "$ref": "#/$defs/platforms" },
          "covers": { "type": "string", "minLength": 1 },
          "last_result": { "anyOf": [ { "$ref": "#/$defs/run" }, { "type": "null" } ] }
        }
      }
    },
    "manual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "title", "phase", "platforms", "verifies_cli_behavior", "priority", "steps", "expected", "observe", "status", "last_run"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{2}$" },
          "group": { "enum": ["basic", "nodes"] },
          "title": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "pattern": "^P[0-9]$" },
          "platforms": { "$ref": "#/$defs/platforms" },
          "verifies_cli_behavior": { "type": "boolean", "description": "Confirms a Claude Code CLI behaviour this design depends on." },
          "priority": { "type": "boolean", "description": "Run first within P0 because the design depends on the result." },
          "steps": { "type": "string", "minLength": 1, "description": "Plain text. `code` and [[ref:section-id]] are rendered by tools/build-doc.js." },
          "expected": { "type": "string", "minLength": 1 },
          "observe": { "type": "string", "minLength": 1 },
          "status": { "enum": ["not-run", "partial", "pass", "fail", "blocked"] },
          "last_run": { "anyOf": [ { "$ref": "#/$defs/run" }, { "type": "null" } ] }
        }
      }
    }
  },
  "$defs": {
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["any", "windows", "macos", "linux"] }
    },
    "run": {
      "type": "object",
      "required": ["date", "env", "result"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "env": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "partial", "fail", "blocked"] },
        "note": { "type": "string" }
      }
    }
  }
}
