# ~/.config/systemd/user/aipager-worker.service
# AIPager Worker (Linux, systemd USER service). Runs as the user who logged in to Claude Code.
# Enable start-at-boot without login:  sudo loginctl enable-linger <user>
# Then:  systemctl --user daemon-reload && systemctl --user enable --now aipager-worker
[Unit]
Description=AIPager Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=AIPAGER_CONFIG=%h/.config/aipager/node.json
Environment=PATH=%h/.volta/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /opt/aipager/scripts/posix/start-worker.sh
Restart=always
RestartSec=5
# mixed: SIGTERM to the worker first (it stops claude process groups cleanly), then SIGKILL leftovers
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
