# /etc/systemd/system/claude-relay-hub.service
# Claude Relay Hub (Linux, systemd system service). The Hub never runs Claude, so it uses a locked-down system user.
[Unit]
Description=Claude Relay Hub
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=claude-relay
Group=claude-relay
Environment=NODE_ENV=production
Environment=RELAY_LOG_LEVEL=info
ExecStart=/opt/node-v22/bin/node /opt/claude-relay/bin/hub.js --config /etc/claude-relay/hub.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Hardening: read-only system, writable data/log dirs only
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/claude-relay /var/log/claude-relay
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
