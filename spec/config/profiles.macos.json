{
  "profiles": {
    "echo": {
      "description": "Smoke test: read-only commands, reports machine info. 驗證用。",
      "workdir": "/Users/<user>/Library/Application Support/AIPager/worker/sandbox",
      "model": "haiku",
      "permission_mode": "default",
      "allowed_tools": ["Bash(hostname)", "Bash(whoami)", "Bash(sw_vers)", "Bash(uname -a)", "Read"],
      "disallowed_tools": ["Edit", "Write", "WebFetch", "WebSearch"],
      "approval": { "auto_allow": [], "auto_deny": ["*"], "timeout_sec": 120 },
      "max_turns": 5,
      "timeout_sec": 120,
      "concurrency_key": "echo"
    },
    "ios": {
      "description": "Build and unit-test the iOS app on a given commit with xcodebuild. Does not modify code or sign for release.",
      "workdir": "/Users/<user>/AIPagerWork/ios-app",
      "repo": { "allow_remote": ["git@gitlab.local:mobile/ios-app.git"], "require_clean": true, "checkout": "detached_commit" },
      "model": "sonnet",
      "permission_mode": "acceptEdits",
      "allowed_tools": [
        "Read", "Grep", "Glob",
        "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)",
        "Bash(xcodebuild -list:*)", "Bash(xcodebuild build:*)", "Bash(xcodebuild test:*)",
        "Bash(xcrun simctl list:*)"
      ],
      "disallowed_tools": ["Bash(git push:*)", "Bash(rm -rf:*)", "Bash(security:*)", "WebFetch", "WebSearch"],
      "approval": { "auto_allow": [], "auto_deny": ["Bash(git push --force*)", "Bash(sudo*)"], "timeout_sec": 600 },
      "max_turns": 40,
      "timeout_sec": 5400,
      "env": { "NSUnbufferedIO": "YES" },
      "pre_commands": ["git fetch origin --prune"],
      "artifacts_max_mb": 50,
      "concurrency_key": "ios-workdir"
    }
  }
}
